  "commands": {
    "unit": "npm run test:marketing",
    "e2e": "node scripts/verify-marketing-browser.mjs"
  },
  "evidence": {
    "crudFullFlow": "scripts/verify-marketing-browser.mjs",
    "failurePaths": "scripts/test-marketing.cjs",
    "campaignFullFlow": "scripts/verify-marketing-campaigns-browser.mjs",
    "campaignTransactions": "scripts/verify-marketing-campaigns-db.cjs"
  }
}
