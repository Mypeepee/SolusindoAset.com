NODE_ENV=development
HOST=127.0.0.1
PORT=3100
WA_TRANSPORT=baileys
# Tujuan konfirmasi stok otomatis untuk lelang yang jadwalnya sudah terlewat.
STOKER_WHATSAPP_NUMBER=6285707379606
# Kirim #boton nomor_klien / #botoff nomor_klien ke nomor kontrol ini
# dari akun WhatsApp agen yang ditautkan ke bot.
BOT_CONTROL_WHATSAPP_NUMBER=6282266100102
# Opsional: nomor uji klien yang secara eksplisit diizinkan merangkap kontak
# internal. Nomor WhatsApp pengirim sendiri tetap tidak dapat menjadi penerima.
BOT_TEST_CLIENT_PHONE=
# Manual WhatsApp reply: 300 = pause 5 minutes; 0 = next client message; -1 = explicit activation only.
MANUAL_REPLY_PAUSE_SECONDS=300
# Jeda minimum balasan otomatis; bukan jaminan terhadap banned.
REPLY_DELAY_MS=2000
# Sesi perangkat tertaut; rahasia dan harus disimpan pada volume persisten.
BAILEYS_AUTH_FILE=./.auth/session.sqlite

# Opsional: hanya dibutuhkan jika WA_TRANSPORT=cloud. Baileys tidak memerlukannya.
WA_API_VERSION=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
# Buat token acak sendiri; samakan dengan Verify Token pada konfigurasi webhook.
WA_VERIFY_TOKEN=

# openai atau gemini. Pilih model yang mendukung structured JSON output.
LLM_PROVIDER=openai
LLM_MODEL=
# Opsional, model lain pada provider/API key yang sama. Tidak dicoba jika kosong.
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_MS=30000
WA_TIMEOUT_MS=10000

# Minimal 32 karakter acak. Digunakan hanya oleh aplikasi/operator CS tepercaya.
ADMIN_API_TOKEN=

# Mode database: endpoint internal aplikasi Next.js. Token khusus, berbeda dari
# ADMIN_API_TOKEN; isi CHATBOT_PROPERTY_TOKEN yang sama di .env.local Next.js.
# HTTP hanya untuk loopback lokal; gunakan HTTPS saat berada di server berbeda.
PROPERTY_API_URL=
CHATBOT_PROPERTY_TOKEN=
PROPERTY_TIMEOUT_MS=12000

# Auto-save funnel WhatsApp ke klien AG108, token tulis terpisah dari token baca.
# Samakan CHATBOT_CLIENT_TOKEN di .env.local aplikasi Next.js.
# Konfigurasi ini juga mengaktifkan booking survei melalui endpoint internal
# /api/internal/chatbot/surveys dengan token yang sama (tidak ada token di chat).
CLIENT_API_URL=
CHATBOT_CLIENT_TOKEN=
CLIENT_TIMEOUT_MS=12000
# Otomatis mengabari klien jika ada listing baru sesuai preferensi CRM.
# Aktif bila CLIENT_API_URL dikonfigurasi & Baileys dipakai. 0 = nonaktif global.
# Per-agent juga dapat dijeda dari panel Integrasi WhatsApp.
AUTO_RECOMMENDATIONS=1

# Fallback katalog file hanya bila mode database tidak dikonfigurasi.
# Relatif terhadap folder backend/whatsapp, bukan terhadap folder aplikasi utama.
ASSETS_FILE=./data/assets.json
DEFAULT_ASSET_ID=
MAX_SESSIONS=2000
MAX_PENDING_MESSAGES=500
MAX_PENDING_PER_PHONE=20
MAX_DEDUP_ENTRIES=20000
SESSION_TTL_HOURS=24
# Reset konteks setelah pelanggan tidak membalas; 30–60 menit. Handoff tetap pause.
SESSION_IDLE_MINUTES=45
